# ==========================================
# 1. 專案專屬設定：防止 AI 讀取或竄改內部 Prompt 與規格
# ==========================================
_hand-off_prompt.md
_Material_Publish_Spec.md
docs/AGENT_*.md
docs/hand-off_prompt.md
docs/feature-prompt*.md
docs/quiz-json-contract*.md

# ==========================================
# 2. 專案專屬設定：防止 AI 讀取本機教材發布產物
# ==========================================
material_templates/.venv/
material_templates/published/

# ==========================================
# 3. 環境變數、金鑰與憑證 (嚴格隱私防護)
# ==========================================
.env
.env.*
*.pem
*.key
*.cert
*.p12
secrets.json
config/database.yml
google-credentials.json
aws-credentials.csv
firebase-adminsdk.json

# ==========================================
# 4. 虛擬環境與套件快取 (減少 AI 索引雜訊)
# ==========================================
node_modules/
venv/
.venv/
env/
__pycache__/

# ==========================================
# 5. 資料庫檔案 (避免 AI 讀取測試資料產生幻覺)
# ==========================================
*.sqlite
*.sqlite3
*.db
dump.sql

# ==========================================
# 6. 特定私密資料夾
# ==========================================
private/
confidential/

# ==========================================
# 7. 專案暫存與特定框架生成檔 (減少 AI 索引雜訊)
# ==========================================
supabase/.temp/
.supabase/
.temp/
.tmp/
.cache/
.next/
dist/
build/

# ==========================================
# 8. 系統與日誌檔 (防止 AI 讀取本地錯誤日誌)
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
**/.DS_Store
Thumbs.db